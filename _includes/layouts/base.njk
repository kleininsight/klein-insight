<!doctype html>
<html lang="en">

<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  
  {% set pageTitle = (title ~ " | Klein Insight") if title else "Klein Insight — Business Strategy & Growth Coaching" %}
  {% set pageDesc = (summary or description or "Business strategy and growth coaching for established owner-led businesses.") | cleanDescription %}
  {% set canonicalUrl = "https://kleininsight.com" ~ page.url %}
  {% if featuredImage and featuredImage != "" %}
    {% set socialImage = "https://kleininsight.com" ~ featuredImage %}
    {% set socialImageWidth = "1200" %}
    {% set socialImageHeight = "630" %}
    {% set socialImageType = "image/png" if ".png" in featuredImage else "image/jpeg" %}
  {% else %}
    {% set socialImage = "https://kleininsight.com/images/og-share-card.jpg" %}
    {% set socialImageWidth = "1200" %}
    {% set socialImageHeight = "630" %}
    {% set socialImageType = "image/jpeg" %}
  {% endif %}

  <title>{{ pageTitle }}</title>
  <meta name="description" content="{{ pageDesc }}">
  <meta name="theme-color" content="#13212b">
  <link rel="canonical" href="{{ canonicalUrl }}">

  <!-- OpenGraph / Facebook Meta Tags -->
  <meta property="og:site_name" content="Klein Insight">
  <meta property="og:locale" content="en_US">
  <meta property="og:type" content="{{ ogType or 'website' }}">
  <meta property="og:title" content="{{ pageTitle }}">
  <meta property="og:description" content="{{ pageDesc }}">
  <meta property="og:url" content="{{ canonicalUrl }}">
  <meta property="og:image" content="{{ socialImage }}">
  <meta property="og:image:secure_url" content="{{ socialImage }}">
  <meta property="og:image:type" content="{{ socialImageType }}">
  <meta property="og:image:width" content="{{ socialImageWidth }}">
  <meta property="og:image:height" content="{{ socialImageHeight }}">
  <meta property="og:image:alt" content="{{ title or 'Klein Insight' }}">

  {% if ogType == "article" %}
  <!-- Article Metadata for Social Slide Previews -->
  <meta property="article:published_time" content="{{ page.date | isoDateTime }}">
  <meta property="article:author" content="https://www.linkedin.com/in/kleininsight/">
  <meta property="article:publisher" content="https://kleininsight.com">
  <meta property="article:section" content="{{ category or 'Business Strategy' }}">
  {% if category %}
  <meta property="article:tag" content="{{ category }}">
  {% endif %}
  {% endif %}

  <!-- Twitter / X Cards -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ pageTitle }}">
  <meta name="twitter:description" content="{{ pageDesc }}">
  <meta name="twitter:image" content="{{ socialImage }}">
  <meta name="twitter:image:alt" content="{{ title or 'Klein Insight' }}">

  <!-- Schema.org JSON-LD Structured Data -->
  {% if ogType == "article" %}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    "mainEntityOfPage": {
      "@type": "WebPage",
      "@id": "{{ canonicalUrl }}"
    },
    "headline": {{ (title or "Strategic Insight") | dump | safe }},
    "description": {{ pageDesc | dump | safe }},
    "image": [
      "{{ socialImage }}"
    ],
    "datePublished": "{{ page.date | isoDateTime }}",
    "author": {
      "@type": "Person",
      "name": "{{ author or 'Joe Klein' }}",
      "jobTitle": "Business Strategy & Growth Coach",
      "url": "https://www.linkedin.com/in/kleininsight/"
    },
    "publisher": {
      "@type": "Organization",
      "name": "Klein Insight",
      "url": "https://kleininsight.com",
      "logo": {
        "@type": "ImageObject",
        "url": "https://kleininsight.com/images/logo-v1.png"
      }
    }
  }
  </script>
  {% else %}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "Klein Insight",
    "url": "https://kleininsight.com",
    "description": "Business strategy and growth coaching for established owner-led businesses."
  }
  </script>
  {% endif %}

  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="alternate" type="application/rss+xml" title="Klein Insight — Insights Feed" href="/feed.xml">
  <link rel="stylesheet" href="/styles.css">
  <link rel="stylesheet" href="/insights.css">
  <link rel="stylesheet" href="/application.css">
</head>

<body id="top">
  <a class="skip-link" href="#main">Skip to content</a>

  <header class="site-header">
    <div class="container nav-wrap">
      <a class="brand" href="/" aria-label="Klein Insight home">
        <img class="brand-logo" src="/images/logo-v1.png" alt="Klein Insight - Driven by Curiosity, Grounded in Strategy" width="282" height="148">
      </a>

      <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-nav">
        Menu
      </button>

      <nav class="site-nav" id="site-nav" aria-label="Primary navigation">
        <a href="/#services">Strategy Coaching</a>
        <a href="/#about">About</a>
        <a href="/insights/" class="{% if '/insights' in page.url %}active-nav{% endif %}">Insights</a>
        <a href="/survey.html" id="navDiagnosticLink">Pulse Check</a>
        <a href="/survey.html?view=results" id="navDossierLink" class="nav-dossier-link" style="display: none;">Pulse Check</a>
        <a href="/survey-deep.html" id="navDeepLink" class="nav-deep-link" style="display: none;">Dossier</a>
        <a class="nav-cta" href="/application.html" data-application-trigger>Let's Talk</a>
      </nav>
    </div>
  </header>

  <main id="main">
    {{ content | safe }}
  </main>

  <footer class="site-footer">
    <div class="container footer-wrap">
      <div>
        <a class="brand footer-brand" href="/" aria-label="Klein Insight home">
          <span class="brand-mark">KI</span>
          <span class="brand-name">Klein Insight</span>
        </a>
        <p>Business Strategy &amp; Growth Coaching</p>
      </div>
      <div class="footer-meta">
        <p>&copy; <span id="year">2026</span> Klein Insight. All rights reserved.</p>
        <a class="back-to-top" href="#top">Back to top</a>
      </div>
    </div>
  </footer>

  <script src="/script.js"></script>
</body>

</html>
