---
layout: layouts/base.njk
ogType: article
---

<!-- Scroll Reading Progress Indicator -->
<div id="readingProgress" class="reading-progress-bar" aria-hidden="true"></div>

<!-- Ambient Post Glow -->
<div class="insight-article-glow" aria-hidden="true"></div>

<article class="insight-article section">
  <div class="container insight-container">
    
    <div class="insight-breadcrumbs">
      <a href="/insights/" class="insight-back-link">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>
        <span>Back to All Insights</span>
      </a>
    </div>

    <header class="insight-header">
      <div class="insight-meta-tags">
        {% if category %}
        <span class="insight-badge insight-category-badge">{{ category }}</span>
        {% endif %}
        {% if source == "linkedin" %}
        <span class="insight-badge insight-linkedin-badge">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>
          From LinkedIn
        </span>
        {% else %}
        <span class="insight-badge insight-site-badge">Strategy Memo</span>
        {% endif %}
      </div>

      <h1 class="insight-title">{{ title }}</h1>

      {% if summary %}
      <p class="insight-subtitle-lead">{{ summary }}</p>
      {% endif %}

      <div class="insight-byline-card">
        <div class="insight-author-card">
          <img class="insight-author-avatar" src="/images/joe-klein-headshot.webp" alt="Joe Klein" width="48" height="48">
          <div class="insight-author-details">
            <div class="author-name-row">
              <span class="insight-author-name">{{ author or "Joe Klein" }}</span>
              <span class="verified-coach-pill" title="Verified Founder & Strategy Coach">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/></svg>
                Coach
              </span>
            </div>
            <div class="insight-date-row">
              <span class="meta-item">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
                <time datetime="{{ page.date | isoDate }}">{{ page.date | readableDate }}</time>
              </span>
              <span class="dot-divider">•</span>
              <span class="meta-item">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
                {{ content | readingTime }}
              </span>
            </div>
          </div>
        </div>
      </div>
    </header>

    {% if source == "linkedin" and linkedinUrl %}
    <aside class="insight-linkedin-callout">
      <div class="linkedin-callout-icon">
        <svg width="26" height="26" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>
      </div>
      <div class="linkedin-callout-text">
        <p class="linkedin-callout-title">Originally shared on Joe Klein's LinkedIn</p>
        <p class="linkedin-callout-sub">This insight was originally published on LinkedIn. Join the ongoing discussion and connect with Joe directly.</p>
      </div>
      <a href="{{ linkedinUrl }}" target="_blank" rel="noopener noreferrer" class="button button-sm button-secondary linkedin-callout-btn">
        <span>Join Discussion</span>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="7" y1="17" x2="17" y2="7"></line><polyline points="7 7 17 7 17 17"></polyline></svg>
      </a>
    </aside>
    {% endif %}

    {% if featuredImage %}
    <figure class="insight-featured-image-wrap">
      <img src="{{ featuredImage }}" alt="{{ title }}" class="insight-featured-image">
    </figure>
    {% endif %}

    <div class="insight-body">
      {{ content | safe }}
    </div>

    <!-- Article Footer & Social Share -->
    <div class="insight-post-footer">
      <div class="insight-share-wrap">
        <span class="insight-share-label">Share this insight with your team:</span>
        <div class="insight-share-links">
          <a href="https://www.linkedin.com/sharing/share-offsite/?url=https://kleininsight.com{{ page.url }}" target="_blank" rel="noopener noreferrer" class="insight-share-btn" aria-label="Share on LinkedIn">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>
            <span>LinkedIn</span>
          </a>
          <a href="https://twitter.com/intent/tweet?text={{ title | urlencode }}&url=https://kleininsight.com{{ page.url }}" target="_blank" rel="noopener noreferrer" class="insight-share-btn" aria-label="Share on X">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
            <span>Post</span>
          </a>
          <button type="button" class="insight-share-btn" id="copyLinkBtn" data-url="https://kleininsight.com{{ page.url }}">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path></svg>
            <span id="copyBtnText">Copy Link</span>
          </button>
        </div>
      </div>
    </div>

    <!-- Strategy Coaching Call to Action -->
    <section class="insight-cta-box">
      <div class="insight-cta-badge-pill">
        <span class="cta-pulse-dot"></span>
        Executive Practice
      </div>
      <div class="insight-cta-content">
        <h2 class="insight-cta-title">Turn Strategic Clarity into Relentless Execution</h2>
        <p class="insight-cta-desc">
          Growth exposes every crack in your operational foundation. If you're an established owner-led business working 60+ hour weeks and feeling the bottleneck, let's identify the exact constraints holding your company back.
        </p>
        <div class="insight-cta-highlights">
          <div class="cta-highlight-item">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
            <span>Confidential diagnostic analysis</span>
          </div>
          <div class="cta-highlight-item">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
            <span>Identify top 3 growth constraints</span>
          </div>
          <div class="cta-highlight-item">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
            <span>Customized 90-day roadmap</span>
          </div>
        </div>
        <div class="insight-cta-actions">
          <a href="/survey.html" class="button button-primary">Take the 5-Minute Pulse Check</a>
          <a href="/application.html" class="button button-outline-light">Apply for Strategy Coaching</a>
        </div>
      </div>
    </section>

  </div>
</article>

<!-- Toast notification for copy link -->
<div id="copyToast" class="copy-toast" role="status" aria-live="polite">
  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
  <span>Link copied to clipboard!</span>
</div>

<script>
  // Scroll reading progress indicator
  const progressBar = document.getElementById('readingProgress');
  window.addEventListener('scroll', () => {
    if (!progressBar) return;
    const docHeight = document.documentElement.scrollHeight - window.innerHeight;
    const scrollPercent = (window.scrollY / docHeight) * 100;
    progressBar.style.width = Math.min(100, Math.max(0, scrollPercent)) + '%';
  }, { passive: true });

  // Copy link with toast feedback
  const copyBtn = document.getElementById('copyLinkBtn');
  const copyText = document.getElementById('copyBtnText');
  const toast = document.getElementById('copyToast');

  if (copyBtn && copyText) {
    copyBtn.addEventListener('click', () => {
      const url = copyBtn.getAttribute('data-url') || window.location.href;
      navigator.clipboard.writeText(url).then(() => {
        copyText.textContent = 'Copied!';
        if (toast) {
          toast.classList.add('visible');
          setTimeout(() => toast.classList.remove('visible'), 2800);
        }
        setTimeout(() => { copyText.textContent = 'Copy Link'; }, 2500);
      }).catch(() => {
        copyText.textContent = 'Copied!';
      });
    });
  }
</script>
