{
  "name": "klein-insight",
  "version": "1.0.0",
  "description": "Klein Insight website with Insights hub and Sveltia CMS",
  "type": "module",
  "scripts": {
    "start": "eleventy --serve",
    "build": "eleventy && node -e \"const fs=require('fs'); fs.cpSync('_site/insights','insights',{recursive:true}); fs.copyFileSync('_site/feed.xml','feed.xml'); fs.copyFileSync('_site/sitemap.xml','sitemap.xml');\""
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@11ty/eleventy": "^3.0.0",
    "@11ty/eleventy-plugin-rss": "^2.0.2"
  }
}
